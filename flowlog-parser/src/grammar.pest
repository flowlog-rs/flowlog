// =============================================================================
// FlowLog GRAMMAR DEFINITION
// =============================================================================
// This grammar defines the syntax for FlowLog, a Datalog language engine
// for declarative data processing and rule-based queries.
//
// Pest builds concrete syntax; Rust lowering checks the context and builds
// typed AST nodes. Recursive alternatives either have distinct token
// prefixes or share one production, so retries do not multiply with nesting
// depth. The sections below keep language concepts separate while sharing
// the productions whose recursive prefixes overlap.

// Main grammar entry point
main_grammar = {
    SOI ~
    (declaration | type_alias_decl | extern_fn | include_directive | input_directive | output_directive | printsize_directive | comp_decl | init_decl | fact | rule)* ~
    EOI
}

// =============================================================================
// BASIC ELEMENTS (IDENTIFIERS, LITERALS, TYPES)
// =============================================================================

// Identifiers exclude reserved keywords in every naming position, including
// each segment of a qualified name.
// Valid examples: x, _temp, myVar123, _private_var
// Invalid examples: 1x, x-yz (hyphen not allowed)
identifier = @{ !keyword ~ identifier_chars }

// Shared spelling for identifiers and names after `?`. The surrounding
// token decides keyword legality: `as` is reserved, but `?as` is a variable.
identifier_chars = _{ "_"? ~ ASCII_ALPHA+ ~ (ASCII_ALPHANUMERIC | "_")* }

// Only syntax keywords are reserved globally. Built-in function, aggregate,
// and primitive type names keep their existing context-dependent meaning;
// dotted directives such as `.type` do not reserve the bare word `type`.
// Atomicity keeps the boundary next to the word, before whitespace/comments.
keyword = @{ as_kw | fn_kw | overridable_kw | boolean }

// A keyword's trailing edge: the next char must NOT continue an identifier,
// so a reserved word matches the whole token and not a prefix (`as` vs
// `assert`, `match` vs `matches`). Silent: produces no node.
word_boundary = _{ !(ASCII_ALPHANUMERIC | "_") }

// Accept Doop's variable spelling without rewriting its rules. Keep the
// prefix in the name so `x` and `?x` bind independently.
// Atomicity keeps whitespace and comments out of the token.
variable = @{ "?" ~ identifier_chars | identifier }

// Schema fields accept the same spelling as rule variables so Doop
// declarations can retain their `?` prefixes.
attribute_name = { variable }

// Relation name as it appears at a *defining* site (`.decl`). Always
// a single identifier: dots are reserved for inliner-produced names.
relation_name = @{ identifier }

// Relation reference at a *use* site (atom, head, directive target).
// Accepts the dotted form so user code can refer to inliner-produced
// relations like `c.Holds`.
relation_ref = @{ identifier ~ ("." ~ identifier)* }

// An attribute's type, one of three forms (the `T` in `.decl R(x: T)`):
//   tuple_type   `(a: symbol, b: number)`    a fixed tuple
//   data_type    `symbol`                    a built-in primitive
//   alias_name   `MyType`                    a user-defined `.type`
// data_type before alias_name so primitives win over the catch-all identifier.
// (`[ ... ]` is reserved for a future array type.)
type_ref = { tuple_type | data_type | alias_name }

// A fixed tuple type, e.g. `(a: symbol, b: number)`: one or more fields, each a
// `type_ref` (so tuples nest). Recursion is rejected by the type registry.
tuple_type  = { "(" ~ tuple_field ~ ("," ~ tuple_field)* ~ ")" }
tuple_field = { attribute_name ~ ":" ~ type_ref }

// A user-declared type name at a *use* site. Resolved against the
// [`TypeRegistry`] after parsing; includes top-level `.type` aliases
// and per-instance prefixed types registered by the component inliner
// (`a.cfg.context`, etc.). Dotted forms support comp-type-parameter
// references like `.decl R(c: cfg.Context)`.
alias_name = @{ identifier ~ ("." ~ identifier)* }

// Data type specification
data_type = { integer8_type | integer16_type | integer32_type | integer64_type
            | uinteger8_type | uinteger16_type | uinteger32_type | uinteger64_type
            | float32_type | float64_type
            | string_type | bool_type }

// 8-bit signed integer data type
integer8_type = { "int8" }

// 16-bit signed integer data type
integer16_type = { "int16" }

// 32-bit signed integer data type ("number" is an alias for "int32")
integer32_type = { "int32" | "number" }

// 64-bit signed integer data type
integer64_type = { "int64" }

// 8-bit unsigned integer data type
uinteger8_type = { "uint8" }

// 16-bit unsigned integer data type
uinteger16_type = { "uint16" }

// 32-bit unsigned integer data type ("unsigned" is an alias for "uint32")
uinteger32_type = { "uint32" | "unsigned" }

// 64-bit unsigned integer data type
uinteger64_type = { "uint64" }

// 32-bit floating point data type ("float" is an alias for "f32")
float32_type = { "float" | "f32" }

// 64-bit floating point data type
float64_type = { "f64" }

// Text data type for strings ("symbol" is an alias for "string")
string_type = { "string" | "symbol" }

// Boolean data type
bool_type = { "bool" }

// Constant values
constant = { boolean | float | integer | string } 

// Float with optional sign, must contain a decimal point
// Examples: 1.5, -3.14, +0.0
float = @{ ("+" | "-")? ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }

// Integer with optional sign, in decimal or `0x` hexadecimal. Lowering
// rewrites a hexadecimal spelling to decimal, so the AST holds one notation.
// Examples: 42, -17, +100, 0xFF, -0x10
integer = @{ ("+" | "-")? ~ (hex_integer | ASCII_DIGIT+) }
hex_integer = _{ "0x" ~ ASCII_HEX_DIGIT+ }

// String literal in Rust syntax: quoted (Rust's escape alphabet) or raw
// (r"..." / r#"..."#, no escapes). Decoded and validated by
// `grammar::decode_string`; unknown escapes are an error, so regex
// patterns belong in raw strings.
string = @{ quoted_string | raw_string }
quoted_string = @{ "\"" ~ ("\\" ~ ANY | !("\"" | "\\") ~ ANY)* ~ "\"" }
raw_string = @{ "r" ~ PUSH("#"*) ~ "\"" ~ (!("\"" ~ PEEK) ~ ANY)* ~ "\"" ~ POP }

// Placeholder for unused variables (underscore)
// Used when you don't need to reference a variable
placeholder = { "_" } 

// Boolean literal values
boolean = { ("True" | "False") ~ word_boundary }

// =============================================================================
// RELATION DECLARATIONS
// =============================================================================
// Relations are the core data structures in FlowLog. They can be:
// - EDB (Extensional Database): Input relations with external data
// - IDB (Intentional Database): Computed relations defined by rules

// Declaration only defines the relation schema. I/O directives are
// separate and can appear anywhere in the program. Optional trailing
// `overridable` is only meaningful inside a `.comp` body.
declaration = {
    ".decl" ~ relation_name ~ "(" ~ attributes_decl? ~ ")" ~ overridable_kw?
}

// Lets a subcomponent's `.override` replace this relation's rules.
overridable_kw = @{ "overridable" ~ word_boundary }

// Input directive for EDB relations - separate from declaration.
// Parens are optional; an empty/missing param list means defaults
// (`IO="file"`, `filename="<RelationName>.facts"`, `delimiter="\t"`).
// Example: .input Relation(IO="file", filename="data.csv", delimiter=",")
// Example: .input Edge                                  // all defaults
input_directive = {
    ".input" ~ relation_ref ~ ("(" ~ io_params? ~ ")")?
}

// Output directive for relations
// Example: .output Relation
// Example: .output Relation(delimiter="|")
output_directive = {
    ".output" ~ relation_ref ~ ("(" ~ io_params? ~ ")")?
}

// Shared key=value parameter list used by both input and output directives
io_params = { io_param ~ ("," ~ io_param)* }

// Individual parameter
io_param = { parameter_name ~ "=" ~ parameter_value }

// Parameter name (IO, filename, delimiter, etc.)
parameter_name = { identifier }

// Parameter value (quoted string)
parameter_value = { string }

// Print size directive for relations - separate from declaration
// Example: .printsize Relation
printsize_directive = {
    ".printsize" ~ relation_ref
}

// Include directive: pull another .dl file into the current program.
// Path is resolved relative to the including file's directory.
// Example: .include "lib/base.dl"
include_directive = { ".include" ~ string }

// Comma-separated list of attribute declarations
// Example: src: number, dst: number, weight: string
attributes_decl = { attribute_decl ~ ("," ~ attribute_decl)* }

// Single attribute with name and type. Type is either a built-in primitive
// or a `.type`-declared alias name (resolved transitively at parse time).
// Example: "src: number" or "src: NodeId" where `NodeId` is a `.type` alias.
attribute_decl = { attribute_name ~ ":" ~ type_ref }

// =============================================================================
// USER-DEFINED EXTERNAL FUNCTION DECLARATIONS
// =============================================================================
//   .extern fn   name(param1: type1, ...) -> ret_type

extern_fn = {
    ".extern" ~ fn_kw ~ identifier ~
    "(" ~ extern_fn_params? ~ ")" ~
    "->" ~ data_type
}

fn_kw = @{ "fn" ~ word_boundary }

extern_fn_params = { extern_fn_param ~ ("," ~ extern_fn_param)* }

extern_fn_param = { identifier ~ ":" ~ data_type }

// =============================================================================
// ARITHMETIC EXPRESSIONS
// =============================================================================
// Mathematical expressions with basic operators

// Arithmetic with precedence
arithmetic_expr = { factor ~ (arithmetic_op ~ factor)* }

// One operand of a value expression. Placeholders belong to atom arguments
// and tuple patterns, not to arithmetic. Casts have their own argument
// grammar; excluding `as` from identifiers prevents a failed cast from
// retrying its recursive operand as a function call (issue #298).
factor = { as_cast | call_expr | paren_factor | constant | variable }

// `as(factor, TargetType)` is an explicit cast and a runtime no-op. The
// typechecker removes it after validating the subtype relationship. Its
// operand is one factor; group arithmetic such as `as((x + 1), T)` first.
as_cast = { as_kw ~ "(" ~ factor ~ "," ~ type_ref ~ ")" }
as_kw = @{ "as" ~ word_boundary }

// =============================================================================
// PARENTHESIZED VALUES AND CONDITION GROUPS
// =============================================================================
// Parentheses share their recursive interior across values and conditions.
// The outer `predicate` retains separate comparison/atom/group alternatives,
// but this interior never re-enters that choice. Retrying an outer comparison
// as a group therefore cannot multiply retries at every depth (issue #355).
//
// In value position, commas distinguish tuples from grouping:
//   (a, b)     tuple construction or destructuring
//   (a, b,)    the same tuple, with an optional trailing comma
//   (a, _)     tuple pattern: ignore the second component
//   (a,)       a 1-tuple, distinct from a grouped value
//   (a + b)    grouped arithmetic, preserving operator precedence
//   (a)        grouped value, collapsed to the original factor
//   (_)        rejected: grouping requires a value, not a placeholder
//
// In predicate position, a bare group contains a nested rule body:
//   (A(x), B(x))   conjunction
//   (A(x); B(x))   disjunction
//   (x + 1) > y    comparison whose left operand is a grouped value
//
// Lowering chooses the interpretation from the surrounding syntax. It
// rejects comparisons/disjunctions in value positions and trailing commas
// in condition groups, using spans from this original parse tree.
paren_factor = { "(" ~ paren_bodies ~ trailing_comma? ~ ")" }

// A parenthesized item can be a value, tuple field, or condition. Parse its
// expression prefix once, then its optional comparison suffix. The enclosing
// AST parser checks which interpretation is legal; it never reparses text.
// These rules must not call `predicate`: doing so would restore the recursive
// comparison/group choice that this shared interior removes.
paren_bodies = { paren_items ~ (";" ~ paren_items)* }
paren_items = { paren_item ~ ("," ~ paren_item)* }
paren_item = {
    negative_string_constraint |
    negative_atom |
    arithmetic_expr ~ (compare_op ~ arithmetic_expr)? |
    placeholder
}

// Visible so lowering can distinguish `(a,)` from `(a)` even though both
// contain only one element.
trailing_comma = { "," }

// =============================================================================
// ARITHMETIC OPERATORS
// =============================================================================
// Arithmetic operators. String concatenation lives in the `cat(a, b)`
// built-in; there is no infix `cat` operator.
arithmetic_op = {
    plus |    // +
    minus |   // -
    times |   // *
    divide |  // /
    modulo    // %
}

// Individual arithmetic operators
plus = { "+" }
minus = { "-" }
times = { "*" }
divide = { "/" }
modulo = { "%" }

// =============================================================================
// COMPARISON EXPRESSIONS
// =============================================================================
// Binary comparisons between arithmetic expressions

// Binary comparison between values, e.g. x + y > z, f(x) = True.
// Parenthesized operands use the shared interior above, so trying this rule
// before a condition group adds a bounded retry, not one retry per depth.
compare_expr = { arithmetic_expr ~ compare_op ~ arithmetic_expr }

// Comparison operators
compare_op = { 
    equal |               // =
    not_equal |           // !=
    greater_equal_than |  // >=
    greater_than |        // >
    less_equal_than |     // <=
    less_than             // <
}

// Individual comparison operators
equal = { "=" }
not_equal = { "!=" }
greater_equal_than = { ">=" }
greater_than = { ">" }
less_equal_than = { "<=" }
less_than = { "<" }

// `!` belongs to negative atoms and string constraints. It is not a general
// unary value operator and cannot prefix an arithmetic comparison.
not_op = { "!" }

// String constraints are predicates with two value operands. The same names
// can also refer to relations (`contains(x)`) or value functions
// (`match(x, y) = True`); the ordering in `predicate` preserves these uses.
string_constraint = {
    string_constraint_op ~ "(" ~ arithmetic_expr ~ "," ~ arithmetic_expr ~ ")"
}
negative_string_constraint = { not_op ~ string_constraint }
string_constraint_op = { match_op | contains_op }
match_op = @{ "match" ~ word_boundary }
contains_op = @{ "contains" ~ word_boundary }

// =============================================================================
// AGGREGATE EXPRESSIONS
// =============================================================================
// Aggregates appear only as direct rule-head arguments. Their operands use
// ordinary arithmetic syntax, so nested calls are value functions:
//   sum(price * qty)    aggregate over an arithmetic expression
//   sum(f(x))           aggregate over the result of a value function
//   f(sum(x))           value call, not an aggregate
//
// Keep this separate from `call_expr`: `head_arg` selects the aggregate
// before a value expression, and is never re-entered by its operand. A failed
// aggregate can retry as a value call without multiplying work with depth.
aggregate_expr = { aggregate_op ~ "(" ~ arithmetic_expr ~ ")" }

// Supported aggregate operators. Spellings are case-sensitive; `AVG` is
// the uppercase spelling of `average`.
aggregate_op = { count | average | sum | min | max }
count = { "count" | "COUNT" }       // Count of elements
average = { "average" | "AVG" }     // Average value
sum = { "sum" | "SUM" }             // Sum of values
min = { "min" | "MIN" }             // Minimum value
max = { "max" | "MAX" }             // Maximum value

// =============================================================================
// VALUE CALLS
// =============================================================================
// Inside shared parentheses a bare call can also become an atom or string
// constraint. Parse its recursive arguments once; the enclosing AST context
// decides which interpretation is legal.
//
//   cat(a, b)           a reserved built-in function
//   my_udf(x, y + 1)    an external function
//
// Dotted names and placeholder arguments are allowed for atoms inside
// parentheses; value lowering rejects both for function calls.
call_expr = { call_name ~ "(" ~ (call_arg ~ ("," ~ call_arg)*)? ~ ")" }

// Preserve a string keyword's token kind for parenthesized conditions, so the
// comparison parser need not duplicate its spellings in Rust. The bounded
// lookahead leaves qualified names such as `match.Rel` as relation references.
call_name = _{ string_constraint_op ~ &"(" | relation_ref }

// Try values before `_` so a variable such as `_x` stays one argument.
// Type arguments belong exclusively to `as_cast`.
call_arg = _{ arithmetic_expr | placeholder }

// =============================================================================
// ATOMS (RELATION REFERENCES)
// =============================================================================
// Relation arguments are constants, variables, or `_`; they cannot contain
// nested calls or arithmetic. This branch has no expression recursion.
atom = { relation_ref ~ "(" ~ (atom_arg ~ ("," ~ atom_arg)*)? ~ ")" }
atom_arg = { constant | variable | placeholder }

// Negation as failure applies to one atom. A single redundant wrapper is
// accepted for Souffle compatibility: !edge(x) and !(edge(x)) are equivalent.
// Negating a condition group or a value expression is not part of this rule.
negative_atom = { not_op ~ ("(" ~ atom ~ ")" | atom) }

// =============================================================================
// RULES SECTION
// =============================================================================
// Rules define how output relations are computed from input relations
// Format: head :- body.
// Example: reachable(x, z) :- edge(x, y), reachable(y, z).

// A fact is a ground tuple inserted directly into a relation.
// Example: edge(1, 2).
fact = { head ~ "." }

// Rule with optional multi-head and multi-body. Commas separate
// alternative heads, semicolons separate alternative bodies:
//   h1, h2 :- b1; b2.  ->  h1:-b1. h1:-b2. h2:-b1. h2:-b2.
//
// A trailing `.plan` hint binds to the rule it immediately follows.
// Parsed as a child here so adjacency is a grammar guarantee, not a
// post-parse check; a `.plan` that follows no rule has no production and
// is a syntax error.
rule = { rule_heads ~ ":-" ~ rule_bodies ~ "." ~ plan_directive? }

// Plan hint pinning the join order of the immediately preceding rule's
// positive body atoms. Indices are 1-based positions of positive atoms in
// the rule's body (negations / comparisons / fn-call predicates are not
// counted). Must be a permutation of `1..=k` where `k` is the count of
// positive atoms. Applied at parse time by permuting the rule's RHS, so
// downstream the source order is the plan order.
//
// An optional `<plan_version> :` prefix is accepted for Souffle
// compatibility. Souffle uses the version to disambiguate clauses in a
// multi-headed/multi-bodied rule; FlowLog already expands those clauses
// during parsing, so the prefix is parsed and discarded: the
// permutation is then applied identically to the native form.
//
// Examples:
//   A(x,z) :- B(x,y), C(y,z), D(z,w).
//   .plan (3, 1, 2)         // native form
//   .plan 1:(3, 1, 2)       // Souffle form, same effect
plan_directive = {
    ".plan" ~ (plan_version ~ ":")? ~ "(" ~ plan_index ~ ("," ~ plan_index)* ~ ")"
}
plan_index = @{ ASCII_DIGIT+ }
plan_version = @{ ASCII_DIGIT+ }

// One or more commas-separated heads
rule_heads = { head ~ ("," ~ head)* }

// One or more semicolon-separated bodies (disjunction)
rule_bodies = { predicates ~ (";" ~ predicates)* }

// Left side of a rule or fact, e.g. reachable(x, z), stats(count(x)).
// Head arguments have their own grammar because they may contain aggregates.
head = { relation_ref ~ "(" ~ (head_arg ~ ("," ~ head_arg)*)? ~ ")" }

// Try aggregates first: `sum(x)` is an aggregate here, while `sum(x, y)`
// falls back to a value call. Once an aggregate matches, it must occupy the
// entire argument: `sum(x) + 1` is rejected by the head's closing delimiter.
// Neither branch recurses into `head_arg`, so this retry has a fixed cost
// relative to parsing its operand, independent of the operand's depth.
head_arg = { aggregate_expr | arithmetic_expr }

// =============================================================================
// BODY PREDICATES
// =============================================================================
// Commas conjoin predicates; semicolons in `rule_bodies` separate alternatives.
predicates = { predicate ~ ("," ~ predicate)* }

// Keep each predicate's grammar and AST parser independent. Order matters:
// comparisons precede atoms so f(x) > 5 is not consumed as a bare relation;
// string constraints precede atoms so match(x, y) remains a constraint.
//
// Only `paren_item` factors the ambiguous recursive expression prefix. These
// outer alternatives can retry it a fixed number of times, but are never
// re-entered from inside it. Keep that boundary when adding predicate forms.
//
//   edge(x, y)           positive relation atom
//   !edge(x, y)          negative relation atom
//   !(edge(x, y))        the same negative atom, with a redundant wrapper
//   f(x) > 5             arithmetic comparison
//   match("a.*", x)      binary string constraint
//   !contains(x, y)      negated string constraint
//   (A(x); B(x))         nested condition group
predicate = {
    compare_expr |
    string_constraint |
    atom |
    negative_string_constraint |
    negative_atom |
    disjunction_group
}

// A grouped condition uses the shared parenthesis interior. Body lowering
// rejects tuple-only syntax such as a trailing comma and expands disjunctions.
disjunction_group = { paren_factor }

// =============================================================================
// TYPE DECLARATIONS (.type)
// =============================================================================
//   .type NodeId  = number    alias (transparent equivalence)
//   .type UserId <: number    subtype (distinct compile-time identity)
//
// Both forms are global, position-independent, and resolved at parse
// time to a primitive root. Subtypes are zero-cost: only the type-
// checker distinguishes them.

type_alias_decl = { ".type" ~ identifier ~ type_decl_op ~ type_ref }
type_decl_op = { subtype_op | alias_op }
subtype_op = { "<:" }
alias_op = { "=" }

// =============================================================================
// COMPONENT DECLARATIONS (.comp / .init)
// =============================================================================
//
//   .comp Container<T> {
//     .decl Holds(x: T)
//     Holds(x) :- Source(x).
//   }
//   .init c = Container<symbol>
//
// `.comp` declares a parameterized template; `.init` instantiates it
// under a name (e.g. `c`). The component inliner pass eliminates both
// before typechecking, leaving only prefixed primitive forms
// (`.decl c.holds(x: symbol)` etc.).

comp_decl = {
    ".comp" ~ identifier ~ comp_type_params? ~ comp_supertype? ~ "{" ~ comp_body_item* ~ "}"
}

// `<T>` or `<T, U>`: names of types this component is parameterized by.
comp_type_params = { "<" ~ identifier ~ ("," ~ identifier)* ~ ">" }

// `: BaseComp<args>` inherits and splices another component's body.
comp_supertype = { ":" ~ identifier ~ comp_type_args? }

// `<symbol, NodeId>`: concrete type arguments. `type_ref` so dotted
// forms like `cfg.Context` work.
comp_type_args = { "<" ~ type_ref ~ ("," ~ type_ref)* ~ ">" }

// `.init c = Container<symbol>`
init_decl = { ".init" ~ identifier ~ "=" ~ identifier ~ comp_type_args? }

// Items allowed inside a component body. Mirrors the top-level grammar
// minus include directives (which are resolved at file-load time), plus
// `override_directive` which is comp-body-only.
// `.plan` is applied at parse time by permuting the preceding rule's
// positive atoms; component inlining (relation-name rewriting) then
// runs on the already-permuted body, so each instantiated rule
// inherits the hint without extra plumbing in the inliner.
comp_body_item = {
    declaration | type_alias_decl | input_directive | output_directive
    | printsize_directive | rule | fact | comp_decl | init_decl
    | override_directive
}

// Drop inherited rules and facts for `Name`; the parent's `.decl Name`
// (which must be `overridable`) is kept.
override_directive = { ".override" ~ identifier }

// =============================================================================
// WHITESPACE AND COMMENTS
// =============================================================================
// Rules for handling whitespace and comments (ignored during parsing)

// Whitespace and comments are ignored during parsing
WHITESPACE = _{ " " | "\t" | NEWLINE }

// Comment starts with # or // and continues until end of line
// Examples: # This is a comment, // Another comment
COMMENT = _{ ("#" | "//") ~ (!NEWLINE ~ ANY)* }
