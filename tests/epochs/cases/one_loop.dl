// One recursion whose edges are static, append and mutable, in a linear
// loop and a non-linear one.

.decl Road(x: int32, y: int32)
.input Road(IO="file", filename="Road.csv", delimiter=",")
.decl Home(x: int32)
.input Home(IO="file", filename="Home.csv", delimiter=",")
.decl Rail(x: int32, y: int32) append
.input Rail(IO="command", delimiter=",")
.decl Ferry(x: int32, y: int32) mutable
.input Ferry(IO="command", delimiter=",")
.decl Visit(x: int32) mutable
.input Visit(IO="command", delimiter=",")

.decl Reach(x: int32)
Reach(x) :- Home(x).
Reach(x) :- Visit(x).
Reach(y) :- Reach(x), Road(x, y).
Reach(y) :- Reach(x), Rail(x, y).
Reach(y) :- Reach(x), Ferry(x, y).
.output Reach

.decl Path(x: int32, y: int32)
Path(x, y) :- Road(x, y).
Path(x, y) :- Rail(x, y).
Path(x, y) :- Ferry(x, y).
Path(x, z) :- Path(x, y), Path(y, z).
.output Path
