// ════════════════════════════════════════════════════════════════════════════
// Suite   : agg_avg
// Feature : mean aggregate expression grouped, answering a float at the
//           width its column declares
// ════════════════════════════════════════════════════════════════════════════

.decl Student(id: int32, class: int32)
.input Student(IO="file", filename="Student.csv", delimiter=",")

.decl Score(student: int32, score: int32)
.input Score(IO="file", filename="Score.csv", delimiter=",")

.decl ClassScore(class: int32, student: int32, score: int32)
ClassScore(c, s, sc) :- Student(s, c), Score(s, sc).

.decl ClassAvg(class: int32, avg: f64)
ClassAvg(c, m) :- ClassScore(c, _, _), m = mean sc : { ClassScore(c, _, sc) }.
.output ClassAvg

.decl ClassAvgNarrow(class: int32, avg: float)
ClassAvgNarrow(c, m) :- ClassScore(c, _, _), m = mean sc : { ClassScore(c, _, sc) }.
.output ClassAvgNarrow
