// ============================================================================
// Suite   : agg_count_no_locals_delta
// Feature : a count whose braces bind no variable of their own, re-checked
//           per epoch over a mutable and an append input
// Covers  : the matches arranged by the key alone change under either
//           signed weight: a group answers 0 from the load on, a first
//           match replaces it, a row inserted again changes nothing, and
//           the last match deleted restores the 0; over four workers
// ============================================================================

.decl R(a: int32)
.input R(IO="file", filename="R.csv", delimiter=",")

.decl S(a: int32) mutable
.input S(IO="command", delimiter=",")

.decl A(a: int32) append
.input A(IO="command", delimiter=",")

// The rule of issue #465 over a mutable input.
.decl C(a: int32, n: int32)
C(a, n) :- R(a), n = count : { S(a) }.
.output C

// Its `_` variant: one count over all of `S`, unchanged when its one row
// is swapped for another.
.decl D(a: int32, n: int32)
D(a, n) :- R(a), n = count : { S(_) }.
.output D

// The rule over an append input.
.decl E(a: int32, n: int32)
E(a, n) :- R(a), n = count : { A(a) }.
.output E
