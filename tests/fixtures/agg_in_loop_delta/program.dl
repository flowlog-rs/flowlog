// A mutable aggregate inside a loop: Hub and Big are mutually recursive,
// so the count over a hub's edges runs at the loop's times. Those have no
// total order to fold matches in and out by, so the count reads its group
// again. Edges come and go: deleting 1->2 takes back every hub but the
// source, 3->1 closes a cycle through it, and deleting 1->3 breaks it.

.decl Source(node: int32)
.input Source(IO="file", filename="Source.csv", delimiter=",")

.decl Edge(src: int32, dst: int32) mutable
.input Edge(IO="command", delimiter=",")

// A hub is a source, or a node a big hub points to.
.decl Hub(node: int32)
Hub(x) :- Source(x).
Hub(y) :- Big(x, _), Edge(x, y).
.output Hub

// A big hub has two or more out-edges.
.decl Big(node: int32, n: int32)
Big(x, n) :- Hub(x), n = count : { Edge(x, y) }, n >= 2.
.output Big
