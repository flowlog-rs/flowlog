// Count and sum expressions over mutable inputs, re-checked per epoch: a
// count over no row answers 0 and a sum over no row answers 0, before any
// transaction and again once every row is gone.

.decl Item(value: symbol) mutable
.input Item(IO="command")

.decl Total(cnt: int32)
Total(c) :- c = count : { Item(value) }.
.output Total

.decl Empty(cnt: int32)
Empty(n) :- Total(n), n = 0.
.output Empty

.decl Amount(value: number) mutable
.input Amount(IO="command")

.decl SumTotal(total: number)
SumTotal(t) :- t = sum value : { Amount(value) }.
.output SumTotal
