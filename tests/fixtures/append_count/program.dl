// ============================================================================
// Suite   : append_count
// Feature : aggregate expressions and a lattice over an append input
//           answer in signed changes. Each new answer retracts the one
//           before; a repeated row counts once; a minimum lattice changes
//           only when a smaller value arrives; a global count keeps one
//           row.
// ============================================================================

.decl Item(k: int32, v: int32) append
.input Item(IO="command", delimiter=",")

.decl Total(k: int32, n: int32)
Total(k, n) :- Item(k, _), n = count : { Item(k, v) }.
.output Total

.decl Low(k: int32, m: min<int32>)
Low(k, v) :- Item(k, v).
.output Low

.decl Size(n: int32)
Size(n) :- n = count : { Item(_, v) }.
.output Size
