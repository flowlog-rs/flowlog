// ============================================================================
// Suite   : recursion_limit_delta
// Feature : a mutable loop returned at a recursion limit of 3 iterations
//           recomputes each epoch: `0` derives `0, 1, 2`, and replacing it
//           with `8` retracts them for `8, 9`. The warning stays, though `8`
//           alone needs no more iterations than the limit.
// ============================================================================

.decl Seed(n: int32) mutable
.input Seed(IO="command", delimiter=",")

.decl Nat(n: int32)
Nat(n) :- Seed(n).
Nat(n + 1) :- Nat(n), n < 9.
.output Nat
