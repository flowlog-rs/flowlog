// ============================================================================
// Suite   : agg_count_no_locals
// Feature : a count whose braces bind no variable of their own
// Covers  : the matches hold the group key alone, so they are arranged by
//           the key with no value, and the aggregate reads that arrangement
//           as one match per key: the rule of issue #465, its `_` variant,
//           whose groups are the one key `()`, and inside a loop; over four
//           workers
// ============================================================================

.decl R(a: int32)
.input R(IO="file", filename="R.csv", delimiter=",")

.decl S(a: int32)
.input S(IO="file", filename="S.csv", delimiter=",")

.decl Edge(x: int32, y: int32)
.input Edge(IO="file", filename="Edge.csv", delimiter=",")

// The rule of issue #465: a group with no match answers 0.
.decl C(a: int32, n: int32)
C(a, n) :- R(a), n = count : { S(a) }.
.output C

// `_` binds nothing either: one count over all of `S`, for every group.
.decl D(a: int32, n: int32)
D(a, n) :- R(a), n = count : { S(_) }.
.output D

// Inside a loop: the walk down from 3 stops at the marked node 1.
.decl Walk(n: int32)
Walk(3).
Walk(y) :- Walk(x), Edge(x, y), count : { S(x) } = 0.
.output Walk
