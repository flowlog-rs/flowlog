// ============================================================================
// Suite   : literal_cast_width
// Feature : a cast gives a numeric literal the width of its target type
// Covers  : the literal keeps that width where nothing else types it, so it
//           does not fall back to int32 or f32 (issue #474): an int64 and a
//           uint64 shift, a value past the int32 range, and an f64 value
//           that f32 would round, in a body filter and in `to_string`
//           arguments
// ============================================================================

.decl K(x: int32)
.input K(IO="file", filename="K.csv", delimiter=",")

// The first repro of #474: `1 bshl 31` is negative in int32 but positive
// in int64.
.decl Sign(sign: symbol)
Sign("positive") :- K(_), as(1, int64) bshl 31 > 0.
Sign("negative") :- K(_), as(1, int64) bshl 31 < 0.
.output Sign

// Each value is computed at its cast's width. At the default width they
// would read 256, -2147483648, a range error (the second repro of #474),
// and 16777216.
.decl Value(name: symbol, value: symbol)
Value("int64 shift", to_string(as(1, int64) bshl 40)) :- K(_).
Value("uint64 shift", to_string(as(1, uint64) bshl 63)) :- K(_).
Value("int64 literal", to_string(as(3000000000, int64))) :- K(_).
Value("f64 literal", to_string(as(16777217.0, f64))) :- K(_).
.output Value
