// ============================================================================
// Suite   : neg_guarded_division
// Feature : a negation guards the head, which is computed only for the rows
//           the negation keeps
// Covers  : `100 / x` never divides by the `x = 0` that `!Z(x)` removes
//           (issue #472: the antijoin computed the head for every row of
//           `N` before dropping the blocked ones, and divided by zero)
// ============================================================================

.decl N(x: int32)
.input N(IO="file", filename="N.csv", delimiter=",")

.decl Z(x: int32)
.input Z(IO="file", filename="Z.csv", delimiter=",")

.decl A(n: int32)
A(100 / x) :- N(x), !Z(x).
.output A
