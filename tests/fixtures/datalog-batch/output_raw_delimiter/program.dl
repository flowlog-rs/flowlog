// ============================================================================
// Suite   : output_raw_delimiter
// Feature : output `delimiter` is written whole, and string columns are raw
// Covers  : a multi-byte `delimiter="||"` emits both bytes at every column
//           boundary, and a string column is written with no quoting and no
//           escaping even when it contains the delimiter or a paren. Pins the
//           two properties a type-directed encoder could silently change:
//           narrowing the delimiter to one byte, and "helpfully" quoting.
// ============================================================================

.decl Raw(s: string, n: int32)
.input Raw(IO="file", filename="Raw.csv", delimiter=",")

.decl Wide(s: string, n: int32)
Wide(s, n) :- Raw(s, n).
.output Wide(delimiter="||", order_by="n")
