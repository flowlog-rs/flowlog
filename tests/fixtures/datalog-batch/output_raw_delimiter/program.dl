// ============================================================================
// Suite   : output_raw_delimiter
// Feature : output string columns are written raw, with no quoting or escaping
// Covers  : a string column is written verbatim even when it contains the
//           output delimiter or a paren, so a row can hold more separators
//           than the arity implies. Pins the property a type-directed encoder
//           could silently change: "helpfully" quoting a cell.
// Note    : the delimiter is one byte on both directions (see the parser's
//           `resolve_delim`), so `delimiter="|"` here, not `"||"`.
// ============================================================================

.decl Raw(s: string, n: int32)
.input Raw(IO="file", filename="Raw.csv", delimiter=",")

.decl Wide(s: string, n: int32)
Wide(s, n) :- Raw(s, n).
.output Wide(delimiter="|", order_by="n")
