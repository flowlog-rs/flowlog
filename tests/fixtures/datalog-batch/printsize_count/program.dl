// ============================================================================
// Suite   : printsize_count
// Feature : `.printsize` reports its count on stdout, never as a file
// Covers  : the report is one line, `<RawName>\t<count>`, on stdout whatever
//           `-D` names. Pins both halves, because the format drifted once
//           already when the sink moved: a count is metadata about a
//           relation, not a row of it, so it is not written like one.
// Note    : Souffle reports `.printsize` the same way, and ignores any
//           `IO=`/`-D` given for it.
// ============================================================================

.decl Edge(a: int32, b: int32)
.input Edge(IO="file", filename="Edge.csv", delimiter=",")

.decl Reach(a: int32, b: int32)
Reach(x, y) :- Edge(x, y).
Reach(x, z) :- Reach(x, y), Edge(y, z).
.printsize Reach
