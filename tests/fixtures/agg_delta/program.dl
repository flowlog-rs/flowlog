// ============================================================================
// Suite   : agg_delta
// Feature : non-recursive sum expression: an EDB change updates the answer
// ============================================================================

.decl Sale(dept: int32, amount: int32) mutable
.input Sale(IO="command", delimiter=",")

.decl DeptTotal(dept: int32, total: int32)
DeptTotal(d, t) :- Sale(d, _), t = sum a : { Sale(d, a) }.
.output DeptTotal
