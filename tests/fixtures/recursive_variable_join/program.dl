// ============================================================================
// Suite   : recursive_variable_join
// Feature : a loop whose first join reads two feedback variables. `Common`
//           joins `FromA` and `FromB` on their only column, and nothing in
//           the loop reads either before, so only the variables' own
//           declarations give the join's key a type. Each walk continues
//           from common nodes only: 9 is reached by both walks, but through
//           5 and 6, which are not common, so it is not common either.
// ============================================================================

.decl EdgeA(src: int32, dst: int32)
.input EdgeA(IO="file", filename="EdgeA.csv", delimiter=",")

.decl EdgeB(src: int32, dst: int32)
.input EdgeB(IO="file", filename="EdgeB.csv", delimiter=",")

.decl Start(node: int32)
.input Start(IO="file", filename="Start.csv", delimiter=",")

.decl FromA(node: int32)
FromA(x) :- Start(x).
FromA(y) :- Common(x), EdgeA(x, y).

.decl FromB(node: int32)
FromB(x) :- Start(x).
FromB(y) :- Common(x), EdgeB(x, y).

.decl Common(node: int32)
Common(x) :- FromA(x), FromB(x).
.output Common
