// ════════════════════════════════════════════════════════════════════════════
// Suite   : multi_txn
// Feature : 3 transactions in sequence with mixed ops, verify _t0/_t1/_t2
// ════════════════════════════════════════════════════════════════════════════

.decl Data(id: int32, val: int32)
.input Data(IO="command", delimiter=",")

.decl Out(id: int32, val: int32)
Out(id, v) :- Data(id, v).
.output Out
