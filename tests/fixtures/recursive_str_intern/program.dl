// ============================================================================
// Suite   : recursive_str_intern
// Feature : Feedback rows must use interned string keys, and the reachable
//           pairs must decode to the original strings on output.
// ============================================================================

.decl Edge(src: string, dst: string)
.input Edge(IO="file", filename="Edge.csv", delimiter=",")

.decl Reach(src: string, dst: string)
Reach(x, y) :- Edge(x, y).
Reach(x, z) :- Reach(x, y), Edge(y, z).
.output Reach
