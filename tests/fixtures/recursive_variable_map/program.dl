// ============================================================================
// Suite   : recursive_variable_map
// Feature : The cross product maps `Open(x), Open(x)` to the empty key
//           before an input constrains the feedback variable's row type.
//           Node 3 has no outgoing edge, so it is excluded.
// ============================================================================

.decl Edge(src: int32, dst: int32)
.input Edge(IO="file", filename="Edge.csv", delimiter=",")

.decl Blocked(node: int32)
.input Blocked(IO="file", filename="Blocked.csv", delimiter=",")

.decl Open(node: int32)
Open(x) :- Edge(x, _).
Open(x) :- Open(x), Open(x), Open(y), !Blocked(y).
.output Open
