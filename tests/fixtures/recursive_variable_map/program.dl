// ============================================================================
// Suite   : recursive_variable_map
// Feature : a loop whose first operator re-keys a feedback variable. The
//           repeated `Open(x), Open(x)` is `Open` keyed by its column, and
//           the cross product with `Open(y), !Blocked(y)` maps it to the
//           empty key before anything else in the loop reads `Open`, so
//           only the variable's own declaration gives the map's input a
//           type. 3 has no out-edge, so it is not open.
// ============================================================================

.decl Edge(src: int32, dst: int32)
.input Edge(IO="file", filename="Edge.csv", delimiter=",")

.decl Blocked(node: int32)
.input Blocked(IO="file", filename="Blocked.csv", delimiter=",")

.decl Open(node: int32)
Open(x) :- Edge(x, _).
Open(x) :- Open(x), Open(x), Open(y), !Blocked(y).
.output Open
