// ============================================================================
// Suite   : recursive_variable_unit_key
// Feature : The first join reads feedback variables while `B(_)` in other
//           rules also arranges `B` by an empty key. Missing row types used
//           to cause both field-access and join-type errors.
// ============================================================================

.decl E(x: int32, y: int32)
E(1, 2).

.decl A(x: int32)
A(1).

.decl B(x: int32)
B(1).
B(c) :- B(c), C(c).

.decl C(x: int32)
C(c) :- B(_), E(c, _).

.decl Out(x: int32)
Out(c) :- A(c), B(_).
.output Out
