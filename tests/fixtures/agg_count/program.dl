// Count and sum expressions over joined and empty matches, grouped and
// global, with and without braces, filtered by their answer, and nested;
// over four workers, so the global answers come from one.

.decl Edge(src: int32, dst: int32)
.input Edge(IO="file", filename="Edge.csv", delimiter=",")

.decl Weight(src: int32, dst: int32, w: int32)
.input Weight(IO="file", filename="Weight.csv", delimiter=",")

.decl Weighted(src: int32, dst: int32)
Weighted(s, d) :- Edge(s, d), Weight(s, d, _).

// One count per source, over its distinct destinations.
.decl OutDeg(src: int32, cnt: int32)
OutDeg(s, c) :- Weighted(s, _), c = count : { Weighted(s, d) }.
.output OutDeg

// One count over every weighted edge; a lone atom needs no braces.
.decl Total(cnt: int32)
Total(c) :- c = count : Weighted(s, d).
.output Total

// A count and a sum over no match answer 0.
.decl EmptyCount(cnt: int32)
EmptyCount(c) :- c = count : { Weighted(s, d), s < 0 }.

.decl Zero(cnt: int32)
Zero(n) :- EmptyCount(n), n = 0.
.output Zero

.decl EmptySum(total: int32)
EmptySum(t) :- t = sum d : { Weighted(_, d), d < 0 }.
.output EmptySum

// A count compared in place keeps the sources with two edges or more.
.decl Busy(src: int32)
Busy(s) :- Weighted(s, _), count : { Weighted(s, d) } >= 2.
.output Busy

// A `max` over a `count`: the largest out-degree.
.decl MaxDeg(cnt: int32)
MaxDeg(m) :- m = max c : { Weighted(s, _), c = count : { Weighted(s, d) } }.
.output MaxDeg
