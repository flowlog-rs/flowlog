// ============================================================================
// Suite   : lattice_string
// Feature : min<string> lattice columns
// Covers  : each key keeps its least text, whatever order its rows arrive
//           in, also when the texts merge around a recursive cycle (issue
//           #466: the generated crate did not build)
// ============================================================================

// Each key's rows arrive out of text order.
.decl Tag(k: int32, s: string)
.input Tag(IO="file", filename="Tag.csv", delimiter=",")

.decl First(k: int32, s: min<string>)
First(k, s) :- Tag(k, s).
.output First

// Names flow along edges: 1, 2 and 3 form a cycle, and 4 and 5 hang off
// it, 5 with no name of its own.
.decl Name(node: int32, name: string)
.input Name(IO="file", filename="Name.csv", delimiter=",")
.decl Edge(src: int32, dst: int32)
.input Edge(IO="file", filename="Edge.csv", delimiter=",")

.decl Least(node: int32, name: min<string>)
Least(n, s) :- Name(n, s).
Least(y, s) :- Least(x, s), Edge(x, y).
.output Least
