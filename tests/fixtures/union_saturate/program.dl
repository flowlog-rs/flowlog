// ============================================================================
// Suite   : union_saturate
// Feature : `union<T>` columns and `skolem` ids, run to saturation
// Covers  : commutativity and associativity merge (1 + 2) + 3 with
//           1 + (2 + 3), and the merged class is named by its smaller input
//           id; `skolem` names each new sum b + c by its parts, so the
//           rebuild merges it with a sum the input already has. The sizes
//           are egglog's for the same program. Four workers rebuild as one
//           does.
// ============================================================================

.type Id <: int64

.decl Num(n: int64, e: union<Id>)
Num(1, 1). Num(2, 2). Num(3, 3).

// Ids 4 to 7 are 1 + 2, (1 + 2) + 3, 2 + 3, and 1 + (2 + 3).
.decl Add(a: Id, b: Id, e: union<Id>)
Add(1, 2, 4). Add(4, 3, 5). Add(2, 3, 6). Add(1, 6, 7).

// a + b = b + a
Add(b, a, e) :- Add(a, b, e).

// (a + b) + c = a + (b + c), with a new id for b + c.
Add(a, t, e), Add(b, c, t) :- Add(s, c, e), Add(a, b, s), t = skolem(1, b, c).

.printsize Num
.printsize Add

// Each named term by its class: 7 joins 5.
.decl Named(name: int64, e: Id)
Named(4, 4). Named(5, 5). Named(6, 6). Named(7, 7).
.output Named
